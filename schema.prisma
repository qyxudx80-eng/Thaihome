generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { OWNER ADMIN AGENT }
enum ListingStatus { DRAFT PENDING_REVIEW PUBLISHED REJECTED ARCHIVED RENTED SOLD }
enum ListingType { SALE RENT }
enum LeadStatus { NEW CONTACTED QUALIFIED CLOSED LOST }

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  listings     Listing[] @relation("ListingAgent")
  reviews      Listing[] @relation("ListingReviewer")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Listing {
  id             String        @id @default(cuid())
  code           String        @unique
  type           ListingType
  status         ListingStatus @default(DRAFT)
  priceTHB       Decimal       @db.Decimal(14, 2)
  bedrooms       Int?
  bathrooms      Int?
  areaSqm        Decimal?      @db.Decimal(10, 2)
  district       String
  province       String
  featured       Boolean       @default(false)
  agentId        String
  agent          User          @relation("ListingAgent", fields: [agentId], references: [id])
  reviewerId     String?
  reviewer       User?         @relation("ListingReviewer", fields: [reviewerId], references: [id])
  reviewedAt     DateTime?
  rejectionNote  String?
  translations   ListingTranslation[]
  images         ListingImage[]
  leads          Lead[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime?
  @@index([status, type, province, district])
  @@index([agentId])
}

model ListingTranslation {
  id          String  @id @default(cuid())
  listingId   String
  locale      String
  title       String
  description String  @db.Text
  address     String?
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@unique([listingId, locale])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Lead {
  id          String     @id @default(cuid())
  listingId   String?
  listing     Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  name        String
  email       String?
  phone       String?
  channel     String
  message     String     @db.Text
  status      LeadStatus @default(NEW)
  assignedTo  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
